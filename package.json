{
  "name": "hivekey",
  "version": "1.4.1",
  "description": "Self-hosted LLM API key pool with multi-protocol support (OpenAI/Anthropic/Responses/Gemini), smart performance-aware scheduling, automatic retry/failover, proxy support and a real-time web dashboard.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "llm",
    "openai",
    "api-pool",
    "load-balancer",
    "proxy",
    "rate-limit",
    "failover"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.2",
    "socks": "^2.8.10",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
